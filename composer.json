{
  "name": "itmosoft/laravel-procurement",
  "description": "Procurement request and approval workflow primitives for Laravel applications, with polymorphic requesters, line items, review decisions, and purchase-order handoff references.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/contracts": "^12.0 || ^13.0",
    "illuminate/database": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.5 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "ITMOSOFT\\Procurement\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ITMOSOFT\\Procurement\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ITMOSOFT\\Procurement\\ProcurementServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-text"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
